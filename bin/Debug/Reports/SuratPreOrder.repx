<EventsScript_X_OnBeforePrint id="ref-116">private void OnBeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e)
{
    XRLabel lbl = sender as XRLabel;

    if (GetCurrentColumnValue(&#34;Debet&#34;) != null)
    {
        int debet = Convert.ToInt32(GetCurrentColumnValue(&#34;Debet&#34;));

        if (debet &#62; 0)
            lbl.ForeColor = System.Drawing.Color.Green;
        else
            lbl.ForeColor = System.Drawing.Color.Black;
    }
}</EventsScript_X_OnBeforePrint>
